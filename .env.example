POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
EMBED_MODEL=bge-m3
# Ollama running natively (GPU): use the docker-compose.native-ollama.yml overlay, for example
# by uncommenting the next line; it also points OLLAMA_URL at the host.
# COMPOSE_FILE=docker-compose.yml:docker-compose.native-ollama.yml
# Only set OLLAMA_URL to use an Ollama elsewhere; it overrides the overlay's host address.
# OLLAMA_URL=http://ollama:11434
# LLM: 'ollama' (default, local, no key) or 'anthropic'
LLM_PROVIDER=ollama
# Model for the chosen provider. Defaults: ollama -> qwen2.5:3b, anthropic -> claude-sonnet-5-5
LLM_MODEL=qwen2.5:3b
LLM_NUM_CTX=8192
LLM_MAX_TOKENS=768
# Only for LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MAX_UPLOAD_MB=50
# Comma-separated browser origins allowed to call the API (the web UI's address)
CORS_ORIGINS=http://localhost:3000
# Relevance gate: max cosine distance of the nearest chunk (calibrated for bge-m3); 'off' disables
MAX_VECTOR_DISTANCE=0.5
# Ingestion worker: attempts per document and seconds without heartbeat before a job is reclaimed
INGEST_MAX_ATTEMPTS=3
INGEST_STALE_SECONDS=600
# API address as seen by the browser (baked into the web UI at build time)
PUBLIC_API_URL=http://localhost:8000
